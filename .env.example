# SurgeGuard configuration template.
#
# Do NOT copy secrets into this file. Run `make setup` (scripts/setup.sh) to generate
# a git-ignored `.env` with freshly generated secrets. Values marked <generated> are
# filled by setup.sh; everything else can be tuned. See docs/configuration.md.

# ---------------------------------------------------------------- general
COMPOSE_PROJECT_NAME=surgeguard
# development | test | staging | production  (production enforces COOKIE_SECURE=true)
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- host bindings
# Everything binds to loopback by default. Change only if you know why.
BIND_ADDRESS=127.0.0.1
PROTECTED_PORT=8080
# Unprotected direct path to the demo backends. Local testing only.
DIRECT_PORT=8081
FRONTEND_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------- API service
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=<generated>
REDIS_KEY_PREFIX=sg
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------- queue and admission
# Visitors admitted per second (token-bucket refill rate).
ADMISSION_RATE=10
# Maximum admissions in a single burst after idle time.
ADMISSION_BURST=10
# Cap on simultaneously valid admission tokens. 0 disables the cap.
MAX_ACTIVE_ADMITTED=0
QUEUE_MAX_SIZE=100000
# How often the waiting room polls status (each poll is a heartbeat).
QUEUE_POLL_INTERVAL_SECONDS=3
# Waiting visitors without a heartbeat for this long are expired.
HEARTBEAT_TIMEOUT_SECONDS=30
# An expired (heartbeat) visitor who returns within this window keeps their place.
REJOIN_GRACE_SECONDS=60
VISITOR_RECORD_TTL_SECONDS=86400
WORKER_TICK_SECONDS=0.5
WORKER_LOCK_TTL_SECONDS=5
WAIT_ESTIMATE_WINDOW_SECONDS=60
WAIT_ESTIMATE_MIN_SAMPLES=5

# ---------------------------------------------------------------- backend health
BACKEND_URLS=http://demo-1:8000,http://demo-2:8000
BACKEND_HEALTH_PATH=/health
BACKEND_HEALTH_INTERVAL_SECONDS=2
BACKEND_HEALTH_TIMEOUT_SECONDS=1
BACKEND_HEALTH_FAILURE_THRESHOLD=2
BACKEND_HEALTH_RECOVERY_THRESHOLD=2

# ---------------------------------------------------------------- admission tokens
TOKEN_TTL_SECONDS=300
TOKEN_SIGNING_SECRET=<generated>
TOKEN_SIGNING_KID=k1
# Optional retired keys still accepted for verification: kid:secret,kid:secret
TOKEN_VERIFY_KEYS=
TOKEN_ISSUER=surgeguard
TOKEN_AUDIENCE=surgeguard-protected
VISITOR_COOKIE_SECRET=<generated>
# true behind HTTPS; false for plain-HTTP localhost.
COOKIE_SECURE=false
# Shared secret Nginx sends to /internal/auth.
INTERNAL_AUTH_SECRET=<generated>
# Shared secret Nginx sends to the protected origin; origin rejects requests without it.
ORIGIN_SHARED_SECRET=<generated>

# ---------------------------------------------------------------- admin console
ADMIN_API_KEY=<generated>
ADMIN_USERNAME=admin
# bcrypt hash, single-quoted so Compose does not interpolate `$`.
ADMIN_PASSWORD_HASH='<generated>'
SESSION_SECRET=<generated>
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Demo login with PUBLIC credentials (shown on the login page, one-click button).
# DEMO_ROLE=admin gives it FULL permissions (pause/resume, reject); viewer makes it read-only.
# Refused unless APP_ENV is development or test. Set DEMO_LOGIN_ENABLED=false (or DEMO_ROLE=viewer)
# before showing the console to anyone you don't trust: with admin, anyone who can open the
# console can control admission.
DEMO_LOGIN_ENABLED=true
DEMO_ROLE=admin
DEMO_USERNAME=demo
DEMO_PASSWORD=surgeguard-demo
# Shareable FULL-PERMISSION reviewer login (can pause/resume admission and reject visitors).
# Password is generated by setup.sh; read it here and share it with reviewers. Not shown on the
# login page. Refused unless APP_ENV is development or test.
REVIEWER_LOGIN_ENABLED=true
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=<generated>

# ---------------------------------------------------------------- rate limiting and caching
# App-level limit on queue joins per client IP (IP is a rate-limit signal only, never identity).
RATE_LIMIT_REQUESTS=2000
RATE_LIMIT_WINDOW_SECONDS=60
# Nginx per-IP limit on the protected entry point. Sized so a single-host k6 run fits.
PROXY_RATE_LIMIT_RPS=500
PROXY_RATE_LIMIT_BURST=1000
# Tighter per-IP budget for queue joins (each join creates queue state).
PROXY_JOIN_RATE_LIMIT_RPS=50
PROXY_JOIN_RATE_LIMIT_BURST=300
# Cache lifetime for public static assets only.
CACHE_TTL_SECONDS=60
PROXY_CONNECT_TIMEOUT_SECONDS=2
PROXY_READ_TIMEOUT_SECONDS=15
PROXY_AUTH_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- fragile demo origin
DEMO_MAX_CONCURRENCY=8
DEMO_WORK_MS=150
DEMO_QUEUE_TIMEOUT_MS=1500

# ---------------------------------------------------------------- frontend
API_INTERNAL_URL=http://api:8000
PROMETHEUS_URL=http://prometheus:9090
PUBLIC_SITE_URL=http://localhost:8080
PUBLIC_GRAFANA_URL=http://localhost:3001

# ---------------------------------------------------------------- monitoring
METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generated>
