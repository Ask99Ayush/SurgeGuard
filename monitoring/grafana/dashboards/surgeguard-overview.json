      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Drill down: Admitted / s",
          "url": "/grafana/d/surgeguard-queue?{__url_time_range}",
