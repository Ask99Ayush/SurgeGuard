          "noValue": "no data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "#43c98b"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ff626b",
                "value": null
              },
              {
                "color": "#f2b84b",
                "value": 1
              },
              {
                "color": "#43c98b",
                "value": 2
              }
