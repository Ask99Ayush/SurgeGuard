    {
      "type": "timeseries",
      "title": "Edge requests vs admitted to origin",
      "description": "Public visitor traffic arriving at Nginx edge vs visitors admitted to origin. Filtered via clamp_min(rate - 0.4, 0) to exclude internal healthcheck probe noise.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(sum(rate(nginx_http_requests_total[$rate_interval])) - 0.4, 0) or vector(0)",
          "legendFormat": "Edge ingress (Nginx)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
