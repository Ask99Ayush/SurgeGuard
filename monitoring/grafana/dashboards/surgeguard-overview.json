    {
      "type": "stat",
      "title": "Error rate",
      "description": "Origin 5xx error ratio. Green <1%, amber 1-5%, red \u22655%. Click to view Backends & Traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_requests_total{status=~\"5..\"}[$rate_interval])) / clamp_min(sum(rate(demo_requests_total[$rate_interval])), 0.001) or vector(0)",
