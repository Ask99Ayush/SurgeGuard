    {
      "type": "stat",
      "title": "Origin error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_requests_total{status=~\"5..\"}[1m])) / sum(rate(demo_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "no data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#ff626b"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ff626b",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
