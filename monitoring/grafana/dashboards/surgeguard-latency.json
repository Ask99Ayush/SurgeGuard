  ],
  "templating": {
    "list": [
      {
        "name": "origin",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "label": "Origin",
        "query": "label_values(demo_requests_total, origin)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "hide": 0
      },
      {
        "name": "rate_interval",
        "type": "custom",
        "label": "Rate Window",
        "query": "1m,2m,5m",
        "current": {
          "text": "1m",
          "value": "1m",
          "selected": true
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": true
          },
          {
            "text": "2m",
            "value": "2m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          }
        ],
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Events",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "expr": "changes(surgeguard_backend_up[30s]) != 0 or changes(surgeguard_admission_paused[30s]) != 0 or changes(surgeguard_worker_is_leader[30s]) != 0",
        "step": "30s",
        "titleFormat": "Cluster Event",
        "textFormat": "Backend probe transition, admission pause/resume, or leader change",
        "iconColor": "#f59e0b",
        "tags": [
          "event"
        ]
      }
    ]
  }
