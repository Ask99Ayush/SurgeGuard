          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 0.5
              },
              {
                "color": "#ef4444",
                "value": 1.0
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "p99 latency",
      "description": "99th percentile tail latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(demo_request_duration_seconds_bucket[$rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
