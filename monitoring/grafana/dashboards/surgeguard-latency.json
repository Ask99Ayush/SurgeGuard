{
  "uid": "surgeguard-latency",
  "title": "SurgeGuard \u00b7 Latency & 5xx",
  "description": "Latency percentile curves, error rates, and HTTP response status codes.",
  "tags": [
    "surgeguard",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "content": "<div style=\"display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;\">\n  <div>\n    <div style=\"font-size: 18px; font-weight: 700; color: #f8fafc; letter-spacing: -0.02em;\">\n      SurgeGuard \u2014 Latency & 5xx\n    </div>\n    <div style=\"font-size: 12px; color: #94a3b8; margin-top: 2px;\">\n      Latency & 5xx \u2014 Origin response times, error rates, and status codes\n    </div>\n  </div>\n  <div style=\"float: right; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); color: #10b981; padding: 5px 12px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 6px;\"><span style=\"display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #10b981;\"></span><span>System Operating Normally &middot; All services healthy &middot; No active incidents</span></div>\n</div>\n<div style=\"margin-top: 6px;\">\n  <a href=\"/grafana/d/surgeguard-overview?{__url_time_range}\" style=\"background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 4px 12px; border-radius: 8px; text-decoration: none; font-size: 12px; margin-right: 6px; display: inline-block;\">1. Overview</a><a href=\"/grafana/d/surgeguard-queue?{__url_time_range}\" style=\"background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 4px 12px; border-radius: 8px; text-decoration: none; font-size: 12px; margin-right: 6px; display: inline-block;\">2. Queue & Admission</a><a href=\"/grafana/d/surgeguard-backends?{__url_time_range}\" style=\"background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 4px 12px; border-radius: 8px; text-decoration: none; font-size: 12px; margin-right: 6px; display: inline-block;\">3. Backends & Traffic</a><a href=\"/grafana/d/surgeguard-failure?{__url_time_range}\" style=\"background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 4px 12px; border-radius: 8px; text-decoration: none; font-size: 12px; margin-right: 6px; display: inline-block;\">4. Reliability & Recovery</a><a href=\"/grafana/d/surgeguard-resources?{__url_time_range}\" style=\"background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 4px 12px; border-radius: 8px; text-decoration: none; font-size: 12px; margin-right: 6px; display: inline-block;\">5. Infrastructure</a><a href=\"/grafana/d/surgeguard-comparison?{__url_time_range}\" style=\"background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 4px 12px; border-radius: 8px; text-decoration: none; font-size: 12px; margin-right: 6px; display: inline-block;\">6. Protected vs Unprotected</a>\n</div>",
        "mode": "html"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "p50 latency",
      "description": "Median origin response time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(demo_request_duration_seconds_bucket[$rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "No traffic yet",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 0.3
              },
              {
                "color": "#ef4444",
                "value": 0.8
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile origin response time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(demo_request_duration_seconds_bucket[$rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
