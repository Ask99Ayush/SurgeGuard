  "templating": {
    "list": [
      {
        "name": "origin",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "label": "Origin Instance",
        "query": "label_values(demo_requests_total, origin)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "hide": 0
      },
      {
        "name": "rate_interval",
        "type": "custom",
        "label": "Rate Window",
        "query": "30s,1m,2m,5m",
        "current": {
          "text": "1m",
          "value": "1m",
          "selected": true
        },
        "options": [
          {
            "text": "30s",
            "value": "30s",
            "selected": false
          },
          {
            "text": "1m",
            "value": "1m",
            "selected": true
          },
          {
            "text": "2m",
            "value": "2m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": false,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Backend down",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "expr": "changes(surgeguard_backend_up[30s]) != 0",
        "step": "30s",
        "titleFormat": "Backend probe change",
        "textFormat": "{{backend}}",
        "iconColor": "#ef4444",
        "tags": [
          "backend"
        ]
      },
      {
        "name": "Admission paused/resumed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "expr": "changes(surgeguard_admission_paused[30s]) != 0",
        "step": "30s",
        "titleFormat": "Admission state change",
        "iconColor": "#f59e0b",
        "tags": [
          "admission"
        ]
      },
      {
        "name": "Worker leader change",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "expr": "changes(surgeguard_worker_is_leader[30s]) != 0",
        "step": "30s",
        "titleFormat": "Leader election",
        "iconColor": "#8b5cf6",
        "tags": [
          "worker"
        ]
      }
    ]
  }
