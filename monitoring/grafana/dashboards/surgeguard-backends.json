{
  "uid": "surgeguard-backends",
  "title": "SurgeGuard \u00b7 Nginx Edge & Traffic",
  "description": "Edge traffic handling, connection pools, and per-instance origin health.",
  "tags": [
    "surgeguard",
    "observability",
    "production",
    "cloud-security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Nginx Edge Ingestion & Connections",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Nginx Edge Requests / s",
      "description": "Public ingress request rate at reverse proxy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nginx_http_requests_total[$rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "noValue": "no data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#06b6d4"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#06b6d4",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
