  "templating": {
    "list": [
      {
        "name": "origin",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "label": "Origin Instance",
        "query": "label_values(demo_requests_total, origin)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "hide": 0
