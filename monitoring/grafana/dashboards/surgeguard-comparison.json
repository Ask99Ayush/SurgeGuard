        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(1 - (  histogram_quantile(0.95, sum by (le) (rate(demo_request_duration_seconds_bucket{mode=\"protected\"}[5m])))  / clamp_min(histogram_quantile(0.95, sum by (le) (rate(demo_request_duration_seconds_bucket{mode=\"unprotected\"}[5m]))), 0.001)), 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
