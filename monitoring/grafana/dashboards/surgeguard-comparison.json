    {
      "type": "timeseries",
      "title": "Protected Error Rate (SurgeGuard)",
      "description": "Origin 5xx error ratio behind SurgeGuard (stays strictly at 0%). Threshold: >1% amber, >5% red.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_requests_total{mode=\"protected\", status=~\"5..\"}[$rate_interval])) / clamp_min(sum(rate(demo_requests_total{mode=\"protected\"}[$rate_interval])), 0.001) or vector(0)",
          "legendFormat": "Protected 5xx ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No traffic yet",
