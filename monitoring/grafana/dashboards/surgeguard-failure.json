{
  "uid": "surgeguard-failure",
  "title": "SurgeGuard \u00b7 Reliability & Failure Testing",
  "description": "What happens when dependencies fail, fail-closed enforcement behavior, and recovery speed.",
  "tags": [
    "surgeguard",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
