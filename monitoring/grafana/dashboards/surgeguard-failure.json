    },
    {
      "type": "stat",
      "title": "API Availability",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"surgeguard-api\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "noValue": "no data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "#94a3b8"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ef4444",
