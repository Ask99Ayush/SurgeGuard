# SurgeGuard Terraform Configuration
# Copy this file to terraform.tfvars (git-ignored) and fill in your values.

aws_region            = "ap-south-1"
project_name          = "surgeguard"
environment           = "dev"

# --- Connect to your existing running EC2 instance (optional) ---
# When set, Terraform attaches your existing EC2 to the ALB and manages its security group.
# Run the EC2 metadata command on your instance to get these IDs:
# existing_instance_id  = "i-0xxxxxxxxxxxxxxxxx"
# existing_vpc_id       = "vpc-0xxxxxxxxxxxxxxxxx"
# existing_subnet_ids   = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"] # At least 2 subnets in different AZs for ALB

# --- SurgeGuard Ports matching .env ---
app_port              = 8088   # Nginx protected gateway
frontend_port         = 3000   # Web App / Admin Console
grafana_port          = 3001   # Grafana SRE Dashboards
direct_port           = 8081   # Direct test backend
ssh_port              = 22     # SSH management
enable_direct_ingress = true   # Allow accessing ports directly via EC2 public IP
enable_ssh            = true

allowed_ingress_cidrs = ["0.0.0.0/0"]
instance_type         = "t3.medium"
app_source_url        = "https://github.com/Ask99Ayush/SurgeGuard.git"
app_version           = "main"
tags                  = { Project = "SurgeGuard", ManagedBy = "terraform" }
