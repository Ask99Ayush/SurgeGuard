#!/bin/bash
# Boot script for the SurgeGuard host (Amazon Linux 2023). Rendered by Terraform; contains no secrets.
set -euo pipefail

dnf install -y docker git jq
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
COMPOSE_VERSION="v2.32.4"
curl -fsSL "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

install -d -m 0750 /opt/surgeguard
cd /opt/surgeguard
if [ ! -d app ]; then git clone --depth 1 --branch "${app_version}" "${app_source_url}" app; fi
cd app

# Secrets & configuration are loaded from the EC2-local .env file (chmod 600).
# Production secrets are never stored in SSM, Terraform state, or user data.
if [ -f .env ]; then
  chmod 600 .env
else
  echo "[i] NOTICE: .env not yet present in /opt/surgeguard/app."
  echo "[i] Create .env from template with restrictive permissions (chmod 600 .env) before running docker compose."
fi

if [ -f .env ]; then
  docker compose up -d --build
fi

