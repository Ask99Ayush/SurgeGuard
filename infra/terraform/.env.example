# Terraform deployment inputs. Copy to infra/terraform/.env (git-ignored) and fill in.
# Loaded by scripts/terraform-env.sh, which exports each KEY as TF_VAR_<lowercase key>.
# Lists and maps use HCL syntax, e.g. ["10.20.0.0/24","10.20.1.0/24"] or {team="ops"}.
# No AWS credentials here: use your normal AWS CLI profile / SSO session.

AWS_REGION=ap-south-1
PROJECT_NAME=surgeguard
ENVIRONMENT=dev
NAME_PREFIX=
VPC_CIDR=10.20.0.0/16
PUBLIC_SUBNET_CIDRS=["10.20.0.0/24","10.20.1.0/24"]
PRIVATE_SUBNET_CIDRS=["10.20.10.0/24","10.20.11.0/24"]
ENABLE_NAT_GATEWAY=true
ALLOWED_INGRESS_CIDRS=["0.0.0.0/0"]
INSTANCE_TYPE=t3.medium
DESIRED_CAPACITY=1
MIN_CAPACITY=1
MAX_CAPACITY=1
USE_SHARED_REDIS=false
APP_PORT=8080
ALB_DELETION_PROTECTION=true
DOMAIN_NAME=
CERTIFICATE_ARN=
APP_SOURCE_URL=https://github.com/<your-org>/surgeguard.git
APP_VERSION=main
SSM_PARAMETER_PREFIX=
TAGS={}
